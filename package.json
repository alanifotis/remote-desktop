{
  "name": "remotedesktopserver",
  "version": "1.0.0",
  "description": "Remote desktop server components",
  "scripts": {
    "protoc": "protoc --proto_path=./Protos --js_out=import_style=commonjs,binary:./wwwroot --grpc-web_out=import_style=typescript,mode=grpcwebtext:./typescript ./Protos/input.proto",
    "tsc": "tsc",
    "build": "npm run tsc && esbuild wwwroot/main.js --bundle --outfile=wwwroot/bundle.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "google-protobuf": "^3.21.2",
    "grpc-tools": "^1.12.4",
    "grpc-web": "^1.5.0",
    "ts-proto": "^2.7.7",
    "typescript": "^5.9.3"
  }
}
